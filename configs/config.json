{
  "project": {
    "group_id": 30,
    "datasets": ["SKAB", "BATADAL"]
  },
  "paths": {
    "raw_data": "data/raw/",
    "processed_data": "data/processed/",
    "logs": "logs/",
    "models": "src/models/saved_weights/",
    "skab_subfolders": ["valve1", "valve2"],
    "batadal_file": "batadal.csv"
  },
  "data_split": {
    "train": 0.60,
    "validation": 0.20,
    "test": 0.20
  },
  "experiment_settings": {
    "random_seeds": [42, 123, 2026, 7, 999],
    "skab_cv_folds": 5,
    "noise_injection": {
      "type": "gaussian",
      "mean": 0.0,
      "std_dev": 0.05
    }
  },
  "deep_learning": {
    "epochs": 50,
    "batch_size": 32,
    "early_stopping_patience": 5,
    "learning_rate": 0.001,
    "sequence_length": 10,
    "anomaly_threshold_percentile": 95
  },
  "automata": {
    "base_params": {
      "window_size": 4,
      "alphabet_size": 3,
      "paa_segment_size": 1,
      "path_probability_threshold": 0.05
    },
    "variation_params": {
      "window_sizes": [3, 4, 5, 6],
      "alphabet_sizes": [3, 4, 5, 6]
    }
  },
  "explainability": {
    "output_format": "json",
    "max_logged_decisions": 50
  }
}
